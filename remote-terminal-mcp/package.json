    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ssh2": "^1.15.5",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
