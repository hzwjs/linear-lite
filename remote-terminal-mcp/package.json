{
  "name": "remote-terminal-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "remote-terminal-mcp": "dist/src/main.js"
  },
  "scripts": {
